{
	"$schema": "./node_modules/wrangler/config-schema.json",
  "name": "study",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-05-22",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist/client"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "408-progress",
      "database_id": "0014480c-e13a-46fa-abb8-84732288519d"
		}
	],
  "r2_buckets": [{ "binding": "PAPERS_BUCKET", "bucket_name": "study-papers" }],
  "secrets": {
		"required": [
			"INVITE_CODES",
			"SESSION_SECRET"
		]
	}
}
